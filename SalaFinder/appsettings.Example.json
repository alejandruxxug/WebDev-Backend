{
  "_comment": "Template only. Copy to appsettings.json and fill in real values. For Azure deploy, set the same keys as Application Settings on the App Service (env vars override this file).",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;Persist Security Info=False;User ID=<user>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Key": "<generate-a-random-32+char-key-and-put-it-in-app-service-config>",
    "Issuer": "SalaFinderApi",
    "Audience": "SalaFinderUsers"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://web-dev-sala-finder.vercel.app",
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
